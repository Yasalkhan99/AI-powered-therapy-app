# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/therapy_app_db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-please-change-this-in-production"

# OpenAI Configuration (Required for AI chat functionality)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ElevenLabs Configuration (Required for voice functionality)
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
